# =============================================================================
# VeriStyle - Production & Vercel Environment Variables
# =============================================================================

# Google Gemini API Key (Required for AI Vision & NLP Authenticity Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (Required for saving scans to Vault / History)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yifveh3.mongodb.net/veristyle?retryWrites=true&w=majority

# Production Node Environment
NODE_ENV=production

# Application URL (Set to your Vercel deployment URL)
APP_URL=https://your-veristyle-app.vercel.app
