{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install --include=dev",
  "rewrites": [
    {
      "source": "/((?!api/.*|assets/.*|favicon.*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
