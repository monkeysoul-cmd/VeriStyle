{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/analyze-url",
      "destination": "/api/analyze-url"
    },
    {
      "source": "/api/analyze-authenticity",
      "destination": "/api/analyze-authenticity"
    },
    {
      "source": "/api/history",
      "destination": "/api/history"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
